{
  "name": "ai-obsidianlike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "个人 AI 知识系统 · 桌面应用（设计基准：design/DESIGN-SPEC.md v1.5 / ADR-0009）",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "vite",
    "app": "electron . --dev",
    "app:mock": "electron . --dev --mock",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "start:mock": "npm run build && electron . --mock",
    "selftest": "npm run build && electron . --selftest",
    "selftest:mock": "npm run build && electron . --selftest --mock",
    "shots": "npm run build && electron . --shots --mock",
    "shots:empty": "npm run build && electron . --shots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
